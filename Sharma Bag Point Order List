<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-c9da4666-d5f7-46d2-a6ad-4acad882701d@mhtml.blink" />
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#142b4a">
<title>Sharma Bag Point Order List</title>

</head>
<body>
<header>
 <div class="brand"><div class="logo">👜</div><div><h1>SHARMA BAG POINT ORDER LIST</h1><p>CUSTOMER &amp; ORDER MANAGEMENT</p></div></div>
 <div class="status" id="connection">● Offline-ready · Saved on this device</div>
</header>
<main>
 <div class="notice"><b>First trial version:</b> Your records are saved in this browser on this device. This version works offline, but it does not yet sync between different phones/computers. Use Backup to move or protect records.</div>
 <nav class="tabs no-print">
  <button class="tab active" data-tab="homePanel">⌂ Home</button>
  <button class="tab" data-tab="ordersPanel">▤ All Orders</button>
  <button class="tab" data-tab="backupPanel">↥ Backup</button>
 </nav>

 <section id="homePanel" class="panel active">
  <div class="card">
   <h2>Find a Customer</h2>
   <div class="home-search"><input id="searchPhone" type="tel" inputmode="tel" placeholder="Search by customer phone number"><button class="btn" id="searchBtn">Search</button></div>
   <div id="searchResults" class="muted" style="margin-top:10px">Enter a phone number to see customer details and previous orders.</div>
  </div>
  <div class="card shop-card" style="margin-top:14px">
   <h2>Welcome to Sharma Bag Point</h2>
   <div class="shop-detail"><span>🏪</span><div><b>SHARMA BAG POINT</b><div class="muted">Your shop's order and customer desk</div></div></div>
   <div class="shop-detail"><span>📍</span><div><b>Shop Location</b><div class="muted">Motor Market, near the main bus stand, Manimajra, Chandigarh, India</div><a href="https://maps.app.goo.gl/BapeB5ML3mppuFUN8" target="_blank" rel="noopener">Open shop location in Google Maps</a></div></div>
   <div class="shop-detail"><span>📞</span><div><b>Contact</b><div class="muted">Add the shop phone number when finalising the branding.</div></div></div>
   <div class="actions"><button class="btn gold">＋ Create New Order</button></div>
  </div>
  <div class="stats" style="margin-top:14px">
   <div class="stat"><b id="totalOrders">0</b><span>Total orders</span></div>
   <div class="stat"><b id="pendingOrders">0</b><span>Pending / in progress</span></div>
   <div class="stat"><b id="completedOrders">0</b><span>Delivered orders</span></div>
  </div>
  <div class="card"><h2>Recent Orders</h2><div id="recentOrders"><p class="muted">No orders yet.</p></div></div>
 </section>

 <section id="newPanel" class="panel">
  <div class="card">
   <h2 id="formTitle">Create New Order</h2>
   <form id="orderForm">
    
    <div class="row">
     <div class="field"><label for="date">Order date (automatic)</label><input id="date" type="date" required=""></div>
     <div class="field"><label for="phone">Customer phone number *</label><input id="phone" type="tel" inputmode="tel" placeholder="Enter phone number" required=""></div>
    </div>
    <div class="row">
     <div class="field"><label for="customer">Customer name *</label><input id="customer" placeholder="Customer full name" required=""></div>
     <div class="field"><label for="quantity">Bag quantity</label><input id="quantity" type="number" min="1" value="1"></div>
    </div>
    <div class="field"><label for="notes">Customer / order notes</label><textarea id="notes" placeholder="Special instructions or customer notes"></textarea></div>
    <h3>Bag specifications</h3>
    <div class="three">
     <div class="field"><label for="size">Size</label><input id="size" placeholder="e.g. 14 x 16"></div>
     <div class="field"><label for="colour">Colour</label><input id="colour" placeholder="e.g. Navy blue"></div>
     <div class="field"><label for="fibre">Fibre / material</label><input id="fibre" placeholder="e.g. Non-woven"></div>
    </div>
    <div class="row">
     <div class="field"><label for="material">Other material details</label><input id="material" placeholder="Fabric, handle, printing, etc."></div>
     <div class="field"><label for="delivery">Expected delivery date</label><input id="delivery" type="date"></div>
    </div>
    <div class="field"><label for="photo">Design reference photo (optional)</label><input id="photo" type="file" accept="image/*"><div class="hint">Small images are saved with the order on this device.</div></div>
    <div class="row">
     <div class="field"><label for="price">Price per bag (₹)</label><input id="price" type="number" min="0" step="0.01" placeholder="0"></div>
     <div class="field"><label for="total">Total amount (₹)</label><input id="total" type="number" min="0" step="0.01" placeholder="Auto-calculated if price is entered"></div>
    </div>
    <div class="row">
     <div class="field"><label>Order status</label><div class="choice" id="orderChoices">
      <button type="button" data-value="Pending" class="selected">Pending</button><button type="button" data-value="In Progress">In Progress</button><button type="button" data-value="Ready">Ready</button><button type="button" data-value="Delivered">Delivered</button>
     </div></div>
     <div class="field"><label>Payment status</label><div class="choice" id="paymentChoices">
      <button type="button" data-value="Not Paid" class="selected">Not Paid</button><button type="button" data-value="Partially Paid">Partially Paid</button><button type="button" data-value="Paid">Paid</button>
     </div></div>
    </div>
    <div class="row">
     <div class="field"><label for="advance">Advance received (₹)</label><input id="advance" type="number" min="0" step="0.01" value="0"></div>
     <div class="field"><label for="balance">Balance remaining (₹)</label><input id="balance" type="number" readonly="" placeholder="Calculated automatically"></div>
    </div>
    <div class="actions">
     <button class="btn gold" type="submit" id="saveBtn">Save Order</button>
     <button class="btn secondary" type="button" id="clearBtn">Clear Form</button>
    </div>
   </form>
  </div>
 </section>

 <section id="ordersPanel" class="panel">
  <div class="card"><div class="order-top"><h2>All Orders</h2><button class="btn secondary no-print">Print List</button></div><div id="allOrders"><p class="muted">No orders saved yet.</p></div></div>
 </section>

 <section id="backupPanel" class="panel">
  <div class="card">
   <h2>Backup &amp; Restore</h2>
   <p class="muted">Download a backup file regularly. You can import it later on this or another device. Importing replaces the records currently in this browser.</p>
   <div class="actions"><button class="btn" id="exportBtn">Download Backup</button><label class="btn secondary" for="importFile" style="cursor:pointer">Restore Backup</label><input id="importFile" class="hidden" type="file" accept="application/json"></div>
   <p class="hint">Keep backup files private because they contain customer names and phone numbers.</p>
  </div>
 </section>
</main>
<footer>SHARMA BAG POINT ORDER LIST · Trial Version</footer>
<button class="fab no-print" type="button" title="Create new order" aria-label="Create new order">＋</button>


</body></html>
