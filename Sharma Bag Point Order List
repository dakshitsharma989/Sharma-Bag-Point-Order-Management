@charset "utf-8";

:root { --navy: #142b4a; --blue: #24558b; --gold: #e7b653; --bg: #f3f6fa; --ink: #182435; --muted: #66758a; --line: #dce4ee; --green: #16845b; --red: #c34d4d; --white: #fff; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--ink); font: 15px / 1.45 system-ui, -apple-system, "Segoe UI", Roboto, Arial; }

header { background: linear-gradient(120deg, rgb(16, 36, 64), rgb(36, 79, 125)); color: white; padding: 20px max(18px, 50% - 580px); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

.brand { display: flex; align-items: center; gap: 13px; }

.logo { width: 48px; height: 48px; border: 2px solid var(--gold); border-radius: 13px; display: grid; place-items: center; font-size: 25px; }

.brand h1 { font-size: 21px; letter-spacing: 0.5px; margin: 0px; }

.brand p { margin: 2px 0px 0px; color: rgb(213, 225, 239); font-size: 12px; letter-spacing: 1.5px; }

.status { font-size: 12px; padding: 7px 11px; border: 1px solid rgba(255, 255, 255, 0.333); border-radius: 20px; }

main { max-width: 1160px; margin: 22px auto; padding: 0px 16px 40px; }

.tabs { display: flex; gap: 8px; overflow: auto; margin-bottom: 18px; }

.tab { border: 1px solid var(--line); background: white; color: var(--navy); border-radius: 10px; padding: 11px 16px; font-weight: 700; white-space: nowrap; cursor: pointer; }

.tab.active { background: var(--navy); color: white; border-color: var(--navy); }

.panel { display: none; }

.panel.active { display: block; }

.grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 14px; }

.full { grid-column: 1 / -1; }

.card { background: white; border: 1px solid var(--line); border-radius: 15px; padding: 18px; box-shadow: rgba(26, 53, 80, 0.04) 0px 4px 16px; }

.card h2 { font-size: 18px; margin: 0px 0px 14px; color: var(--navy); }

.card h3 { font-size: 15px; margin: 0px 0px 10px; color: var(--navy); }

label { display: block; font-size: 13px; font-weight: 700; color: rgb(64, 81, 106); margin: 0px 0px 5px; }

input, textarea, select { width: 100%; padding: 11px 12px; border: 1px solid rgb(207, 217, 229); border-radius: 9px; background: rgb(255, 255, 255); color: var(--ink); font: inherit; min-width: 0px; }

textarea { min-height: 76px; resize: vertical; }

.field { margin-bottom: 12px; }

.row { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 12px; }

.three { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 10px; }

.actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }

.btn { border: 0px; border-radius: 9px; padding: 11px 15px; font-weight: 750; cursor: pointer; background: var(--navy); color: white; }

.btn.secondary { background: rgb(234, 240, 247); color: var(--navy); }

.btn.gold { background: var(--gold); color: rgb(57, 43, 18); }

.btn.danger { background: rgb(255, 240, 240); color: var(--red); }

.btn.small { padding: 7px 10px; font-size: 12px; }

.choice { display: flex; gap: 8px; flex-wrap: wrap; }

.choice button { background: rgb(241, 244, 248); border: 1px solid rgb(214, 223, 235); color: rgb(52, 68, 90); border-radius: 9px; padding: 9px 13px; font-weight: 700; cursor: pointer; }

.choice button.selected { background: var(--navy); border-color: var(--navy); color: white; }

.hint { font-size: 12px; color: var(--muted); margin-top: 5px; }

.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 15px; }

.stat { background: white; border: 1px solid var(--line); border-radius: 13px; padding: 15px; }

.stat b { font-size: 25px; color: var(--navy); display: block; }

.stat span { font-size: 12px; color: var(--muted); }

.result { border: 1px solid var(--line); border-radius: 10px; padding: 12px; margin-top: 10px; background: rgb(251, 252, 254); }

.order { border: 1px solid var(--line); border-radius: 11px; padding: 13px; margin: 10px 0px; background: white; }

.order-top { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }

.pill { font-size: 11px; border-radius: 20px; padding: 4px 8px; background: rgb(234, 240, 247); color: var(--navy); font-weight: 800; }

.pill.green { background: rgb(231, 246, 239); color: rgb(17, 115, 78); }

.pill.red { background: rgb(255, 240, 240); color: rgb(181, 62, 62); }

.muted { color: var(--muted); font-size: 13px; }

.hidden { display: none !important; }

.notice { padding: 11px 13px; background: rgb(255, 248, 232); border: 1px solid rgb(240, 223, 182); border-radius: 10px; color: rgb(112, 85, 28); font-size: 13px; margin-bottom: 15px; }

.home-search { display: flex; gap: 8px; }

.home-search input { flex: 1 1 0%; }

.shop-card { background: linear-gradient(135deg, rgb(255, 255, 255), rgb(244, 247, 251)); border: 1px dashed rgb(158, 175, 196); }

.shop-detail { display: flex; gap: 10px; align-items: flex-start; padding: 9px 0px; border-bottom: 1px dashed rgb(215, 224, 235); }

.shop-detail:last-child { border-bottom: 0px; }

.fab { position: fixed; right: 22px; bottom: 22px; width: 60px; height: 60px; border: 0px; border-radius: 50%; background: var(--gold); color: rgb(45, 37, 23); font-size: 34px; line-height: 1; box-shadow: rgba(23, 43, 74, 0.333) 0px 7px 22px; cursor: pointer; z-index: 20; }

.fab:active { transform: scale(0.96); }

footer { text-align: center; color: rgb(128, 144, 164); font-size: 12px; padding: 20px; }

@media (max-width: 700px) {
  .grid, .row { grid-template-columns: 1fr; }
  .three { grid-template-columns: 1fr 1fr; }
  .stats { grid-template-columns: 1fr 1fr; }
  .stats .stat:last-child { grid-column: 1 / -1; }
  header { padding: 17px; }
  .brand h1 { font-size: 18px; }
}

@media print {
  header, .tabs, .no-print, footer { display: none !important; }
  body { background: white; }
  .panel { display: none !important; }
  #ordersPanel { display: block !important; }
  .card { box-shadow: none; }
}
